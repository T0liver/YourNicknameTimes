# Copy to smoke.local.env on the Pi and fill in. chmod 600 smoke.local.env
# These variables are for milestone 0 smoke tests only — not data/secrets.env.

# Baïkal (CalDAV) — same host for calendars and tasks
CALDAV_URL=https://baikal.example/dav.php/
CALDAV_USER=
CALDAV_PASSWORD=

# OpenRouter
OPENROUTER_API_KEY=
# Optional; defaults to openrouter/free
OPENROUTER_MODEL=openrouter/free

# Dropbox app-folder app (smoke upload)
# App permissions must include files.content.write (and typically files.metadata.read).
# Use a short-lived access token from the OAuth flow, or a refresh token pair.
DROPBOX_ACCESS_TOKEN=
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=

# CUPS — leave empty to use the system default printer
PRINTER_NAME=

# Optional label for keys-for-1.3.local.md (e.g. Brother HL-L2350DW)
BROTHER_MODEL=
